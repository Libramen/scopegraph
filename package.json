{
  "name": "scopegraph",
  "version": "0.1.0",
  "private": true,
  "description": "Graph-based scoping for agentic commerce: model what a business sells, what it needs to know, and what it refuses — then serve it to AI agents over MCP and HTTP.",
  "author": "Libramen, Inc.",
  "keywords": [
    "agentic-commerce",
    "mcp",
    "mcp-server",
    "checkout",
    "payments",
    "stripe",
    "quoting",
    "booking",
    "rules-engine",
    "yaml",
    "service-business"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Libramen/scopegraph.git"
  },
  "homepage": "https://github.com/Libramen/scopegraph#readme",
  "bugs": {
    "url": "https://github.com/Libramen/scopegraph/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "scopegraph": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sg": "tsx src/cli/index.ts",
    "validate": "tsx src/cli/index.ts validate",
    "scenarios": "tsx src/cli/index.ts test",
    "simulate": "tsx src/cli/index.ts simulate",
    "dev": "tsx watch src/cli/index.ts serve --watch",
    "start": "node dist/cli/index.js serve",
    "schema": "tsx scripts/schema.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@ucp-js/sdk": "0.5.1",
    "express": "^5.3.0",
    "mppx": "0.21.1",
    "re2js": "2.10.0",
    "stripe": "23.2.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "ajv": "8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "zod-to-json-schema": "3.25.2"
  }
}
