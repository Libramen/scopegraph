{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scopegraph offering",
  "description": "One offering of a scopegraph catalog (catalog/offerings/<id>.yaml; the file name is the id). Reference: docs/catalog-format.md",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "product",
        "package"
      ],
      "default": "product"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "category": {
      "type": "string",
      "maxLength": 100
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ],
      "default": "active"
    },
    "bookable": {
      "type": "boolean",
      "default": true
    },
    "price": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "per": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "amount"
          ],
          "additionalProperties": false
        }
      ]
    },
    "taxable": {
      "type": "boolean"
    },
    "contains": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          {
            "type": "object",
            "properties": {
              "offering": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "default": 1
              }
            },
            "required": [
              "offering"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "discount": {
      "type": "object",
      "properties": {
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "amount": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "date": {
      "type": "string",
      "enum": [
        "none",
        "optional",
        "required"
      ],
      "default": "none"
    },
    "minNoticeHours": {
      "type": "number",
      "minimum": 0
    },
    "ask": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "date",
              "time",
              "datetime",
              "select",
              "multiselect"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "options": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "pattern": {
            "type": "string",
            "maxLength": 256
          },
          "default": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "quantity",
              "fact"
            ]
          },
          "internal": {
            "type": "boolean"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "choose": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "mode": {
            "type": "string",
            "enum": [
              "single",
              "multi"
            ],
            "default": "single"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "min": {
            "type": "integer",
            "minimum": 0
          },
          "max": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "options": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "minItems": 1
              },
              {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 1000
                        },
                        "price": {
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "object",
                              "properties": {
                                "amount": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "per": {
                                  "type": "string",
                                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                }
                              },
                              "required": [
                                "amount"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "pricing": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_]{0,63}$"
                              },
                              "label": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200
                              },
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "addon",
                                  "surcharge",
                                  "discount",
                                  "fee"
                                ]
                              },
                              "when": {
                                "type": "object",
                                "additionalProperties": {}
                              },
                              "amount": {
                                "type": "number",
                                "minimum": 0
                              },
                              "percent": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                              },
                              "per": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_]{0,63}$"
                              },
                              "tiers": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "from": {
                                      "type": "number",
                                      "minimum": 0
                                    },
                                    "to": {
                                      "type": "number",
                                      "exclusiveMinimum": 0
                                    },
                                    "amount": {
                                      "type": "number",
                                      "minimum": 0
                                    }
                                  },
                                  "required": [
                                    "from",
                                    "amount"
                                  ],
                                  "additionalProperties": false
                                },
                                "minItems": 1
                              },
                              "formula": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048
                              },
                              "basis": {
                                "type": "string",
                                "enum": [
                                  "running",
                                  "base"
                                ]
                              },
                              "taxable": {
                                "type": "boolean"
                              },
                              "reason": {
                                "type": "string",
                                "maxLength": 200
                              },
                              "order": {
                                "type": "integer"
                              }
                            },
                            "required": [
                              "label",
                              "kind"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "taxable": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              }
            ]
          }
        },
        "required": [
          "options"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "when": {
            "type": "object",
            "additionalProperties": {}
          },
          "block": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "require": {
            "type": "string",
            "minLength": 1
          },
          "exclude": {
            "type": "string",
            "minLength": 1
          },
          "ask": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "priority": {
            "type": "integer"
          },
          "active": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "pricing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "addon",
              "surcharge",
              "discount",
              "fee"
            ]
          },
          "when": {
            "type": "object",
            "additionalProperties": {}
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "per": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "tiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "number",
                  "minimum": 0
                },
                "to": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "amount": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "from",
                "amount"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "formula": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "basis": {
            "type": "string",
            "enum": [
              "running",
              "base"
            ]
          },
          "taxable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "order": {
            "type": "integer"
          }
        },
        "required": [
          "label",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "minimumSpend": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": [
            "decline",
            "top_up"
          ]
        }
      },
      "required": [
        "amount",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
