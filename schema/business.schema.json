{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scopegraph business.yaml",
  "description": "Business-wide settings of a scopegraph catalog (catalog/business.yaml). Reference: docs/catalog-format.md",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "default": "USD"
    },
    "timezone": {
      "type": "string",
      "default": "UTC"
    },
    "taxRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "seasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "peak",
              "off_peak",
              "custom"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "sun",
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat"
              ]
            },
            "minItems": 1
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "disclosure": {
      "type": "string",
      "enum": [
        "progressive",
        "menu"
      ],
      "default": "progressive"
    },
    "handoff": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "payments": {
      "type": "object",
      "properties": {
        "confirmation": {
          "type": "string",
          "enum": [
            "owner_approves",
            "instant"
          ],
          "default": "owner_approves"
        },
        "approvalWindowHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 96,
          "default": 24
        },
        "quoteTtlMinutes": {
          "type": "integer",
          "minimum": 30,
          "maximum": 240,
          "default": 30
        },
        "successUrl": {
          "type": "string",
          "format": "uri"
        },
        "cancelUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
