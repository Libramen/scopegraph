{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scopegraph scenarios",
  "description": "Executable specs for a scopegraph catalog (scenarios/*.yaml): a list of scenarios or { defaults, scenarios }. Reference: docs/catalog-format.md",
  "anyOf": [
    {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "offering": {
            "type": "string",
            "minLength": 1
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "selections": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "date": {
            "type": "string"
          },
          "facts": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "now": {
            "type": "string"
          },
          "expect": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "qualified",
                  "needs_input",
                  "blocked",
                  "invalid",
                  "unavailable"
                ]
              },
              "asks": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "error": {
                "type": "string"
              },
              "total": {
                "type": "number"
              },
              "subtotal": {
                "type": "number"
              },
              "tax": {
                "type": "number"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "offering",
          "expect"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "object",
      "properties": {
        "defaults": {
          "type": "object",
          "properties": {
            "now": {
              "type": "string"
            },
            "facts": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "offering": {
                "type": "string",
                "minLength": 1
              },
              "answers": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "selections": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "date": {
                "type": "string"
              },
              "facts": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "now": {
                "type": "string"
              },
              "expect": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "qualified",
                      "needs_input",
                      "blocked",
                      "invalid",
                      "unavailable"
                    ]
                  },
                  "asks": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "rule": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  },
                  "total": {
                    "type": "number"
                  },
                  "subtotal": {
                    "type": "number"
                  },
                  "tax": {
                    "type": "number"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "offering",
              "expect"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "scenarios"
      ],
      "additionalProperties": false
    }
  ]
}
