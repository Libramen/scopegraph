# scopegraph server environment — copy to .env (next to package.json) and adjust.
# The CLI (npm run dev / sg / validate / orders …) reads this checkout's .env at
# startup, never a .env in the working directory. Variables already set in the
# environment win; NODE_* keys here are ignored; with NODE_ENV=production the
# file is not read at all. Docker (NODE_ENV=production): docker run --env-file .env
# (the image never contains .env). Every variable is optional; defaults shown
# (with STRIPE_SECRET_KEY set, the payments block below lists what becomes required).

# Listen port (HTTP mode).
PORT=3000

# Bind address. 0.0.0.0 binds all interfaces (containers); use 127.0.0.1 to
# keep the server local-only.
HOST=0.0.0.0

# CORS: comma-separated list of allowed browser origins, or * to allow all.
# Non-browser clients send no Origin header and are unaffected.
# Leave unset to serve same-origin only.
#ALLOWED_ORIGINS=https://your-site.example.com,https://app.your-site.example.com

# Requests per minute per client on every route except /health (fixed window,
# in-memory; path case and trailing slashes do not matter). A client is one
# IPv4 address or one IPv6 /64 (IPv4-mapped IPv6 counts as the IPv4 address).
# Requests with a valid ADMIN_TOKEN or a valid signed approve/reject link are
# never limited; other requests to those owner routes get their own per-client
# bucket of 10× this, and so does the Stripe webhook (Stripe retries on 429).
RATE_LIMIT_PER_MINUTE=60

# Behind a reverse proxy / platform load balancer (or Cloudflare, nginx)
# set this so rate limits (and the per-client quote quota) key on the real
# client IP (X-Forwarded-For) instead of putting every client in the proxy's
# one bucket. Use the number of proxies in front of the server: 1 for one
# proxy (a typical platform). `loopback` or a comma-separated IP/CIDR list
# of your proxies also works. `true` is refused at boot (the server exits
# with an error): it would take the left-most X-Forwarded-For entry, which
# the client writes itself, so anyone could pick a fresh "IP" per request and
# bypass every limit. Unset: not trusted.
#TRUST_PROXY=1

# Set to 'true' to include the engine explanation trace in every scope
# response (HTTP and MCP), for debugging. It exposes: the buyer's own answers,
# defaults and date-derived values; every active rule's id, whether it fired
# and which names it was missing; the price adjustments that applied (id,
# label, amount); pending question keys; and warnings (ignored answers and
# selections). Blocked reasons also gain their `ruleId`. These are removed:
# fact values, internal-parameter values, fact and internal-parameter names
# in `unknownRefs`, warnings about facts and pricing failures, and
# adjustments that did not apply. Keep off in production: with
# NODE_ENV=production the server prints a warning at boot when it is on.
#EXPOSE_TRACE=false

# Absolute public base URL (scheme + host [+ port]) used for links in
# /.well-known/mcp.json, /llms.txt, and (when payments are on) payment
# links, approval links and public order pages. https in production. Set
# this in every deployment: unset, the discovery documents build links from
# the request's Host header (sent Cache-Control: no-store so no shared cache
# replays a forged Host) and the server prints a boot warning. Required when
# payments are on. A loopback URL (localhost) is refused with a live Stripe key.
#PUBLIC_URL=https://your-business.example.com

# Hooks (src/extend/*.ts) may read their own secrets, e.g.:
#CRM_TOKEN=
# ── CLI (scopegraph validate/test/orders — not read by the server) ──────────

# Catalog directory used by CLI commands when --catalog is not passed.
#SCOPEGRAPH_CATALOG=./catalog

# Scenarios directory for 'scopegraph test' when --scenarios is not passed.
#SCOPEGRAPH_SCENARIOS=./scenarios

# Any non-empty value disables ANSI colors in CLI output (no-color.org).
#NO_COLOR=1

# ── Payments (all optional: unset STRIPE_SECRET_KEY = payments off) ─────────
# See docs/payments.md before enabling. One Stripe account per deployment.

# Enables payments. Use a RESTRICTED key with exactly: Payment Intents
# write, Checkout Sessions write, Charges and Refunds write (safety refunds),
# Shared Payment Tokens read (test mode here: sk_test_…/rk_test_…).
#STRIPE_SECRET_KEY=sk_test_…

# Signing secret of the webhook endpoint at <PUBLIC_URL>/webhooks/stripe
# (Dashboard → Developers → Webhooks). Required when payments are on.
# whsec_ plus at least 16 characters.
#STRIPE_WEBHOOK_SECRET=whsec_…

# Stripe agent business profile id (Dashboard → Settings → Agentic
# commerce; profile_test_… in test mode). Needed by the agent doors
# (UCP/ACP/MPP) that charge shared payment tokens.
#STRIPE_PROFILE_ID=profile_test_…

# Bearer token for the admin API and the 'scopegraph orders' CLI.
# Required when payments are on; >= 32 chars: openssl rand -hex 32
#ADMIN_TOKEN=

# Signs the approve/reject links passed to the onApprovalNeeded hook
# (src/extend/orders.ts). Required when payments are on. >= 32 bytes:
# openssl rand -hex 32. Must differ from ADMIN_TOKEN.
#ORDER_SIGNING_SECRET=

# Where payments.json (orders, the quotes they were started from, checkouts)
# lives. Default ./data — put it on a persistent volume in production; one
# server process only (DATA_DIR/.lock, refreshed every 10s, enforces it; a
# lock silent for 60s is taken over).
#DATA_DIR=./data

# Enables the ACP door (/acp checkout protocol) for the agents you issue
# tokens to: comma-separated bearer tokens, each >= 32 chars
# (openssl rand -hex 32), never the ADMIN_TOKEN.
#ACP_BEARER_TOKENS=

# Optional ACP order webhooks (status changes pushed to your system). Set
# both or neither; the secret is >= 32 chars.
#ACP_WEBHOOK_URL=https://your-system.example.com/acp-orders
#ACP_WEBHOOK_SECRET=

# Enables the MPP door (HTTP 402 machine payments). Instant confirmation
# only: ignored with a warning when payments.confirmation is owner_approves.
#MPP_ENABLED=true
